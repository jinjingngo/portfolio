{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npx biome check)",
			"Bash(npx biome check:*)",
			"Bash(npx tsc --noEmit)",
			"Bash(npm run lint)",
			"Bash(npm run lint:fix)",
			"Bash(pnpm lint)",
			"Bash(pnpm lint:fix)",
			"Bash(pnpm exec biome check:*)",
			"Bash(pnpm exec tsc --noEmit)",
			"Bash(pnpm test)"
		],
		"deny": [
			"Bash(npm run deploy:*)",
			"Bash(npm run upload:*)",
			"Bash(pnpm run deploy:*)",
			"Bash(pnpm run upload:*)",
			"Bash(pnpm upload:*)",
			"Bash(pnpm exec wrangler deploy:*)",
			"Bash(pnpm exec wrangler secret:*)",
			"Bash(pnpm wrangler deploy:*)",
			"Bash(pnpm wrangler secret:*)",
			"Bash(pnpm exec opennextjs-cloudflare deploy:*)",
			"Bash(npx -y pnpm@10 run deploy:*)",
			"Bash(npx -y pnpm@10 run upload:*)",
			"Bash(npx wrangler deploy:*)",
			"Bash(npx wrangler secret:*)",
			"Bash(npx opennextjs-cloudflare deploy:*)",
			"Read(./.dev.vars)",
			"Read(./.env*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "f=$(node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>process.stdout.write(JSON.parse(s).tool_input?.file_path??\"\"))'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*) cd \"$CLAUDE_PROJECT_DIR\" && pnpm exec biome format --write --no-errors-on-unmatched \"$f\" >/dev/null 2>&1 ;; esac; exit 0",
						"timeout": 30
					}
				]
			}
		]
	}
}
