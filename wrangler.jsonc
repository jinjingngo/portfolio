{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker.ts wraps OpenNext's .open-next/worker.js and adds the Durable Objects.
	"main": "worker.ts",
	"name": "portfolio",
	"compatibility_date": "2026-02-25",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "portfolio"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"workers_dev": true,
	"preview_urls": true,
	// Workers AI for /api/translate/image. Has no local mode: `pnpm dev` uses the
	// real account and spends the same daily allowance.
	"ai": {
		"binding": "AI"
	},
	// Exact daily/per-client caps for camera translate, one object per UTC day.
	"durable_objects": {
		"bindings": [
			{ "name": "TRANSLATE_QUOTA", "class_name": "TranslateQuota" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TranslateQuota"] }],
	"kv_namespaces": [
		{
			"binding": "PUSH_SUBSCRIPTIONS",
			"id": "053d4fa52f49449cbc066b48435b5a6f"
		}
	],
	// Worker Previews (PR builds run `pnpm run upload:preview`). Bindings aren't
	// inherited, so each is declared here. KV points at a preview-only namespace
	// so previews never touch real push subscribers; each Preview gets its own
	// TranslateQuota storage; AI is the real account (shared daily allowance).
	"previews": {
		"ai": { "binding": "AI" },
		"durable_objects": {
			"bindings": [
				{ "name": "TRANSLATE_QUOTA", "class_name": "TranslateQuota" }
			]
		},
		"kv_namespaces": [
			{
				"binding": "PUSH_SUBSCRIPTIONS",
				"id": "4c4213cf66e54bf2a67b361eb9c07a0f"
			}
		],
		"services": [
			{ "binding": "WORKER_SELF_REFERENCE", "service": "portfolio" }
		],
		"images": { "binding": "IMAGES" }
	}
}
